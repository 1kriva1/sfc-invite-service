    <ProjectGuid>81dded9d-158b-e303-5f62-77a2896d2a5a</ProjectGuid>
    <DockerLaunchAction>LaunchBrowser</DockerLaunchAction>
    <DockerServiceUrl>{Scheme}://localhost:{ServicePort}/swagger</DockerServiceUrl>
    <DockerServiceName>sfc-invite</DockerServiceName>
    <DockerComposeProjectName>sfc-invite</DockerComposeProjectName>
    <DockerComposeBaseFilePath>compose.Development</DockerComposeBaseFilePath>
    <DockerComposeEnvFilePath>environments/api/api.Development.env</DockerComposeEnvFilePath>
    <UserSecretsId>d9000aaa-4c39-45fd-82db-6d4fa223c683</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="global.json" />
  </ItemGroup>
  <ItemGroup>
